# Copy to .env and fill in locally. Never commit the real values.

# --- GitHub App (apps/github-app) ---
GITHUB_APP_ID=
# Path to the App's private key file (keep it outside the repo or gitignored; *.pem is ignored)
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
PORT=3000

# --- Runners and job queue (apps/github-app) ---
# Per-runner tokens: JSON file of runner ids + SHA-256 token hashes (no plaintext tokens).
# Create entries with:  npm run -s runner-token -- mint --id <runner-id> [--repo owner/name]
RUNSTAGE_RUNNERS_FILE=.runstage-gate-data/runners.json
# Durable job queue (single JSON file, atomic writes). Survives App restarts.
RUNSTAGE_QUEUE_FILE=.runstage-gate-data/queue.json
# A claimed job goes back to the queue if its runner sends no heartbeat for this long.
RUNSTAGE_JOB_LEASE_SECONDS=900

# On the RUNNER machine only: that runner's own token (printed once by `runner-token mint`).
# Legacy: if RUNSTAGE_RUNNERS_FILE does not exist, the App accepts this one shared token as
# runner "legacy-shared" and logs a warning. Migrate to per-runner tokens.
RUNSTAGE_RUNNER_TOKEN=

# Optional: hosted history service (apps/history)
RUNSTAGE_HISTORY_URL=http://localhost:3100
# Write token: the App sends it as a bearer on POST /runs. Also grants read access.
# When any history token is set, the UI and read API require a token (fail closed).
# With none set, history is open to anyone who can reach the port (local dev only).
RUNSTAGE_HISTORY_TOKEN=
# Optional read-only token for people/tools that view history (bearer, or paste it at /login).
RUNSTAGE_HISTORY_READ_TOKEN=
# Set to 1 when history is served over HTTPS so the session cookie gets the Secure flag.
HISTORY_COOKIE_SECURE=
HISTORY_PORT=3100
HISTORY_DATA_FILE=.runstage-gate-data/runs.json
