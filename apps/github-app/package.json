{
  "name": "@runstage-gate/github-app",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "GitHub App webhook server: creates the 'RunStage Gate' check run, queues jobs for runners, completes the check.",
  "exports": {
    ".": {
      "runstage-dist": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --conditions=runstage-dist dist/main.js",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@octokit/app": "^16.1.0",
    "@octokit/webhooks": "^14.2.0",
    "@runstage-gate/core": "0.1.0"
  }
}
